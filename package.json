    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "express": "^5.2.1",
    "playwright-core": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solc": "0.8.28",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
